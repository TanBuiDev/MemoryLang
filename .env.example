VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Image search API keys (used by Edge Function search-images)
# Get keys at: unsplash.com/developers | pexels.com/api | pixabay.com/api
# Run: pnpm sync:secrets   to push these to Supabase
UNSPLASH_ACCESS_KEY=your-unsplash-access-key
PEXELS_API_KEY=your-pexels-api-key
PIXABAY_API_KEY=your-pixabay-api-key

# Database export (Supabase Dashboard → Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Cloud TTS - Base64 of Service Account JSON key file
# 1. Create Service Account with "Cloud Text-to-Speech API User" role
# 2. Download JSON key
# 3. Convert to base64: powershell -c "[Convert]::ToBase64String([IO.File]::ReadAllBytes('path\to\key.json'))"
# Run: pnpm sync:secrets   to push these to Supabase
GOOGLE_TTS_CREDENTIALS_B64=

# Cloudflare R2 (object storage for generated audio)
# 1. Create R2 bucket (e.g. "memorylang-audio")
# 2. Enable Public Access → r2.dev subdomain (or custom domain)
# 3. Create API token: R2 Dashboard → Manage R2 API Tokens
# Run: pnpm sync:secrets   to push these to Supabase
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=english-audio-cache
R2_PUBLIC_DOMAIN=