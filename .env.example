VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Direct PostgreSQL access for Supabase CLI / Java statistics API
# Keep the real password only in .env or a secret manager.
SUPABASE_DB_PASSWORD=your-database-password

# Image search API keys (used by Edge Function search-images)
# Get keys at: unsplash.com/developers | pexels.com/api | pixabay.com/api
# Run: pnpm sync:secrets   to push these to Supabase
UNSPLASH_ACCESS_KEY=your-unsplash-access-key
PEXELS_API_KEY=your-pexels-api-key
PIXABAY_API_KEY=your-pixabay-api-key

# Database export (Supabase Dashboard → Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Cloud TTS - Base64 of Service Account JSON key file
# 1. Create Service Account with "Cloud Text-to-Speech API User" role
# 2. Download JSON key
# 3. Convert to base64: powershell -c "[Convert]::ToBase64String([IO.File]::ReadAllBytes('path\to\key.json'))"
# Run: pnpm sync:secrets   to push these to Supabase
GOOGLE_TTS_CREDENTIALS_B64=

# Cloudflare R2 (object storage for generated audio)
# 1. Create R2 bucket (e.g. "memorylang-audio")
# 2. Enable Public Access → r2.dev subdomain (or custom domain)
# 3. Create API token: R2 Dashboard → Manage R2 API Tokens
# Run: pnpm sync:secrets   to push these to Supabase
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=english-audio-cache
R2_PUBLIC_DOMAIN=

# Cloudflare Pages Deploy
# 1. Create API Token: https://dash.cloudflare.com/profile/api-tokens → "Create Token" → "Cloudflare Pages" template
# 2. Get Account ID: Cloudflare Dashboard → Overview → Account ID
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# PayOS — VietQR Payment Gateway
# 1. Đăng ký tại: https://payos.vn
# 2. Lấy credentials: PayOS Dashboard → Kênh thanh toán → API Keys
# Run: pnpm sync:secrets   to push these to Supabase
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Resend — Email Notifications
# 1. Đăng ký tại: https://resend.com
# 2. Lấy API Key: Resend Dashboard → API Keys → Create
# Run: pnpm sync:secrets   to push these to Supabase
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@memorylang.com

# AI Tutor (Supabase Edge Function only; never use VITE_ prefixes)
# Gemini is the primary provider while Google Cloud free-trial credits are active.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=

# Optional provider after/alongside the Google Cloud trial
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
